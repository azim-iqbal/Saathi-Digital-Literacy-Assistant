# Install privately as /etc/saathi/backend.env, mode 0600. Do not copy development tokens.
GEMINI_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
GEMINI_MODEL=REPLACE_WITH_SUPPORTED_MODEL
GROQ_API_KEY=REPLACE_WITH_SERVER_SIDE_KEY
GROQ_MODEL=REPLACE_WITH_SUPPORTED_MODEL
SAATHI_MAX_PROVIDER_CALLS=100
SAATHI_MAX_CALLS_PER_PROVIDER=50
# Use the host's maintained system CA trust. Never disable TLS verification.

# Navigation tries this model first; fallback uses the other only when needed.
# Incident assessment and explicit Check APIs still require both providers.
SAATHI_PRIMARY_PROVIDER=gemini

# Optional bounded research; these are operator-reviewed configuration, not model keys.
# Install the reviewed JSON registry read-only, owned by the deployment administrator.
# SAATHI_RESEARCH_SOURCES=/etc/saathi/research-sources.json
# Optional HTTPS SearXNG /search endpoint with JSON enabled (no default public instance).
# SAATHI_SEARCH_ENDPOINT=https://YOUR_REVIEWED_SEARCH_HOST/search
# Search and each retrieved page consume the existing durable global/per-user allowance.

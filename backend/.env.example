# Copy to backend/.env (ignored by Git). Never put these values in Android source or APKs.
# Mock is the zero-external-call default. Choose dual_ai only after configuring both accounts.
SAATHI_PROVIDER_MODE=mock
SAATHI_DEV_TOKEN=REPLACE_WITH_A_RANDOM_32_OR_MORE_CHARACTER_TOKEN
GEMINI_API_KEY=REPLACE_WITH_YOUR_SERVER_SIDE_KEY
GEMINI_MODEL=REPLACE_WITH_A_CURRENT_SUPPORTED_TEXT_MODEL
GROQ_API_KEY=REPLACE_WITH_YOUR_SERVER_SIDE_KEY
GROQ_MODEL=REPLACE_WITH_A_CURRENT_SUPPORTED_TEXT_MODEL
# Server call caps persist in this local SQLite file; they are not currency/billing limits.
SAATHI_BUDGET_DB=backend/local-budget.sqlite3
SAATHI_MAX_PROVIDER_CALLS=100
SAATHI_MAX_CALLS_PER_PROVIDER=50
